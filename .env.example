# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# App Configuration
NEXT_PUBLIC_APP_NAME=عيادة
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Storage
NEXT_PUBLIC_STORAGE_BASE_URL=https://cdn.your-domain.com

# Sentry (error monitoring + performance + replay).
# Optional locally; required on Vercel for production error reports.
# DSN is safe to expose; auth token is build-time only and server-side.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
